# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）

# Web UI 登录账号。不设 AUTH_PASSWORD 时首次启动会自动生成随机密码并写入 .env
AUTH_USERNAME=admin
#AUTH_PASSWORD=

# mihomo 本地代理的分组名（出口轮换 / 避开按 IP 的限流用）。不用该功能则留空
#MIHOMO_GROUP=

# mihomo 配置文件路径（读 controller 地址与 secret）。默认 ~/mihomo/config.yaml
#MIHOMO_CONFIG=

# 书签采集密钥：「站点管理 → 采集 Token」生成的脚本内嵌此密钥，登录站点后一键回填 token。
# 不设置则采集功能禁用（建议设置任意随机字符串）
#COLLECT_KEY=

# 访问需代理站点的出口。默认 http://127.0.0.1:7890
#HTTPS_PROXY=http://127.0.0.1:7890
